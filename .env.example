# ===========================================
# ButlerAI - Variabili Ambiente
# ===========================================
# Copia questo file in .env e completa con i tuoi valori

# -------------------------------------------
# FLUTTER APP
# -------------------------------------------
FLUTTER_APP_NAME=ButlerAI
FLUTTER_APP_VERSION=1.0.0
FLUTTER_APP_BUILD_NUMBER=1

# -------------------------------------------
# SUPABASE
# -------------------------------------------
SUPABASE_URL=https://tuo-progetto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -------------------------------------------
# SUPABASE FUNCTIONS (per AI proxy)
# -------------------------------------------
SUPABASE_FUNCTIONS_URL=https://tuo-progetto.supabase.co/functions/v1

# -------------------------------------------
# MISTRAL AI API
# -------------------------------------------
MISTRAL_API_KEY=tuo_api_key_mistral
MISTRAL_VISION_MODEL=pixtral-large-latest
MISTRAL_TEXT_MODEL=mistral-small-latest

# -------------------------------------------
# FIREBASE CLOUD MESSAGING (FCM)
# -------------------------------------------
FCM_SERVER_KEY=AAAAxxxxxxx:APA91bxxxxxxxx...

# -------------------------------------------
# STRIPE / REVENUECAT
# -------------------------------------------
# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# RevenueCat (alternativa)
REVENUECAT_API_KEY=appl_xxxxxxxx

# -------------------------------------------
# APPLE APP STORE
# -------------------------------------------
APP_STORE_SHARED_SECRET=xxxxx

# -------------------------------------------
# GOOGLE PLAY STORE
# -------------------------------------------
GOOGLE_PLAY_LICENSE_KEY=xxxxx

# -------------------------------------------
# NOTIFICHE PUSH
# -------------------------------------------
# Android
ANDROID_FCM_DEFAULT_CHANNEL=butlerai_notifications

# iOS
IOS_APNS_TOPIC=com.butlerai.app

# -------------------------------------------
# DEBUG & LOGGING
# -------------------------------------------
DEBUG_MODE=true
LOG_LEVEL=debug  # debug, info, warning, error

# -------------------------------------------
# AMBIENTE
# -------------------------------------------
# Sviluppo: development
# Produzione: production
# Staging: staging
ENVIRONMENT=development

# ===========================================
# ISTRUZIONI
# ===========================================
# 1. Copia questo file in .env
# 2. Non committare MAI il file .env in Git
# 3. Aggiungi .env a .gitignore
# 4. Per Supabase, trova le chiavi in:
#    Dashboard Supabase → Project Settings → API
# 5. Per Mistral, trova la API key in:
#    https://console.mistral.ai/api-keys
# 6. Per Stripe, trova le chiavi in:
#    https://dashboard.stripe.com/test/apikeys
